---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { site, sourceUrl } from "../site.config";
import marketplace from "../../../.claude-plugin/marketplace.json";

const skills = (await getCollection("skills")).sort((a, b) => a.id.localeCompare(b.id));
const agents = (await getCollection("agents")).sort((a, b) => a.id.localeCompare(b.id));
const repo = site.repo;
const mcpUrl = new URL("/mcp", Astro.site).href;
const cursorConfig = JSON.stringify({ mcpServers: { "nikolovski-lab": { url: mcpUrl } } }, null, 2);
const vscodeConfig = JSON.stringify({ name: "nikolovski-lab", type: "http", url: mcpUrl });

// Starter packs are marketplace entries that point at the repo root and list skill folders.
const packs = (marketplace.plugins as { name: string; description: string; source: string; skills?: string[] }[])
  .filter((p) => p.source === "./" && Array.isArray(p.skills))
  .map((p) => ({ ...p, skillIds: p.skills!.map((s) => s.replace(/^\.\/skills\//, "").replace(/\/$/, "")) }));
---
<Base title="Toolkit" description="Skills, starter packs and agents with one-line installs.">
  <h1>Toolkit</h1>
  <p class="lede">Install everything at once in Claude Code, a starter pack, or one skill at a time in any agent.</p>

  <h2>Claude Code: everything</h2>
  <pre><code>/plugin marketplace add {repo}
/plugin install nikolovski-lab@nikolovski-lab</code></pre>

  <h2>Claude Code: starter packs</h2>
  <p class="muted">A smaller bundle for one kind of work. Add the marketplace once, then install a pack.</p>
  <ul class="list">
    {packs.map((p) => (
      <li class="card" id={p.name}>
        <h3><a href={sourceUrl(`plugins/${p.name}/README.md`)}>{p.name}</a></h3>
        <p>{p.description}</p>
        <p class="meta" style="margin-top:8px">Skills: {p.skillIds.map((id, i) => (<>{i > 0 && ", "}<a href={`#${id}`}>{id}</a></>))}</p>
        <pre><code>/plugin marketplace add {repo}
/plugin install {p.name}@{marketplace.name}</code></pre>
      </li>
    ))}
  </ul>

  <h2 id="mcp">MCP server: search and pull from any agent</h2>
  <p>Point your agent at <code>{mcpUrl}</code> and it can search and fetch every skill and published lesson here, no install. Read-only, no sign-in. Tools: <code>search_skills</code>, <code>get_skill</code>, <code>search_lessons</code>, <code>get_lesson</code>.</p>
  <p class="meta" style="margin-top:8px">Claude Code</p>
  <pre><code>claude mcp add --transport http nikolovski-lab {mcpUrl}</code></pre>
  <p class="meta" style="margin-top:8px">Codex CLI</p>
  <pre><code>codex mcp add nikolovski-lab --url {mcpUrl}</code></pre>
  <p class="meta" style="margin-top:8px">Cursor (in <code>~/.cursor/mcp.json</code>)</p>
  <pre><code>{cursorConfig}</code></pre>
  <p class="meta" style="margin-top:8px">VS Code</p>
  <pre><code>code --add-mcp '{vscodeConfig}'</code></pre>
  <p class="meta" style="margin-top:8px">Gemini CLI</p>
  <pre><code>gemini mcp add --transport http nikolovski-lab {mcpUrl}</code></pre>
  <p class="meta" style="margin-top:8px">Claude.ai and Claude Desktop: Settings &gt; Connectors &gt; Add custom connector, with the URL above.</p>

  <h2>Skills</h2>
  <ul class="list">
    {skills.map((s) => (
      <li class="card" id={s.id}>
        <h3><a href={sourceUrl(`skills/${s.id}/SKILL.md`)}>{s.data.name}</a></h3>
        <p>{s.data.description}</p>
        <p class="meta" style="margin-top:8px">Codex</p>
        <pre><code>npx skills add {repo} --skill {s.id} -a codex</code></pre>
        <p class="meta" style="margin-top:8px">Cursor</p>
        <pre><code>npx skills add {repo} --skill {s.id} -a cursor</code></pre>
        <p class="meta" style="margin-top:8px">Any other agent (pick it when prompted)</p>
        <pre><code>npx skills add {repo} --skill {s.id}</code></pre>
      </li>
    ))}
  </ul>

  <h2>Agents</h2>
  {agents.length === 0 ? (
    <p class="muted">No agents yet.</p>
  ) : (
    <ul class="list">
      {agents.map((a) => (
        <li class="card">
          <h3><a href={sourceUrl(`agents/${a.id}.md`)}>{a.data.name}</a></h3>
          <p>{a.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</Base>
