---
import Base from "../../layouts/Base.astro";
import { render } from "astro:content";
import { allDemos, demoParts } from "../../lib/demos";
import { formatDate } from "../../lib/lessons";
import { sourceUrl } from "../../site.config";

export async function getStaticPaths() {
  const demos = await allDemos();
  return demos.map((demo) => ({ params: { id: demo.id }, props: { demo } }));
}

const { demo } = Astro.props;
const parts = await demoParts(demo.id);
const { Content: Changed } = await render(demo);
const { Content: Task } = await render(parts.task);
const { Content: Without } = await render(parts.without);
const { Content: With } = await render(parts.withSkill);
---
<Base title={demo.data.title} description={demo.data.summary} wide>
  <p class="meta"><a href="/demos/">← Demos</a></p>
  <h1>{demo.data.title}</h1>
  <p class="meta">
    skill <a href={`/toolkit/#${demo.data.skill}`}>{demo.data.skill}</a>
    · outputs generated by {demo.data.generated_by} on {formatDate(demo.data.generated)}
    · <a href={sourceUrl(`demos/${demo.id}/`)}>source</a>
  </p>
  <p class="lede">{demo.data.summary}</p>

  <section class="card changed">
    <h2>What changed</h2>
    <div class="prose"><Changed /></div>
    <p class="meta">{demo.data.setup}</p>
  </section>

  <details class="card task">
    <summary><strong>The task</strong> (same message both times)</summary>
    <div class="prose"><Task /></div>
  </details>

  <div class="compare">
    <section class="pane">
      <h2>Without the skill</h2>
      <div class="prose scroll"><Without /></div>
    </section>
    <section class="pane">
      <h2>With the skill</h2>
      <div class="prose scroll"><With /></div>
    </section>
  </div>
</Base>

<style>
  .changed h2 { margin-top: 0; }
  .changed .meta { margin-top: 8px; }
  .task { margin-top: 16px; }
  .task summary { cursor: pointer; }
  .compare { display: grid; gap: 16px; margin-top: 16px; }
  .pane { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 16px; min-width: 0; }
  .pane h2 { margin-top: 0; }
  .prose :global(pre) { white-space: pre-wrap; word-break: break-word; }
  @media (min-width: 900px) {
    .compare { grid-template-columns: 1fr 1fr; }
    .scroll { max-height: 75vh; overflow-y: auto; padding-right: 8px; }
  }
</style>
