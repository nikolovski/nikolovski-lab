---
import Base from "../../layouts/Base.astro";
import { render } from "astro:content";
import { publishedLessons, formatDate } from "../../lib/lessons";

export async function getStaticPaths() {
  const lessons = await publishedLessons();
  return lessons.map((lesson) => ({ params: { id: lesson.id }, props: { lesson } }));
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.summary}>
  <p class="meta"><a href="/lessons/">← Lessons</a></p>
  <h1>{lesson.data.title}</h1>
  <p class="meta">
    {formatDate(lesson.data.date)}
    {lesson.data.skill && <> · produced the skill <a href={`/toolkit/#${lesson.data.skill}`}>{lesson.data.skill}</a></>}
  </p>
  <article class="prose"><Content /></article>
  {lesson.data.tags.length > 0 && <p>{lesson.data.tags.map((t) => <span class="tag">{t}</span>)}</p>}
</Base>
