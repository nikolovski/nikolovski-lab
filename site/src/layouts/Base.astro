---
import { site, repoUrl } from "../site.config";
import Mermaid from "../components/Mermaid.astro";

interface Props {
  title?: string;
  description?: string;
  /** Wider main column, for side-by-side content such as demos. */
  wide?: boolean;
}
const { title, description = site.tagline, wide = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const path = Astro.url.pathname;
const nav = [
  { href: "/lessons/", label: "Lessons" },
  { href: "/toolkit/", label: "Toolkit" },
  { href: "/demos/", label: "Demos" },
  { href: "/resources/", label: "Resources" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
  </head>
  <body>
    <header class="wrap">
      <a class="brand" href="/">{site.title}</a>
      <nav>
        {nav.map((n) => (
          <a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>{n.label}</a>
        ))}
        <a href={repoUrl}>GitHub</a>
      </nav>
    </header>
    <main class:list={["wrap", { wide }]}>
      <slot />
    </main>
    <Mermaid />
    <footer class="wrap">
      <p>Everything here is plain files in <a href={repoUrl}>one Git repo</a>.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfbfa;
    --fg: #1b1b1a;
    --muted: #6b6b66;
    --line: #e4e4df;
    --card: #ffffff;
    --accent: #2f5bd3;
    --code: #f1f1ee;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121212;
      --fg: #ececea;
      --muted: #9a9a94;
      --line: #2a2a28;
      --card: #1a1a19;
      --accent: #8aa8ff;
      --code: #222220;
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.6 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 16px; }
  header.wrap {
    display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; justify-content: space-between;
    padding-top: 24px; padding-bottom: 24px; border-bottom: 1px solid var(--line);
  }
  .brand { font-weight: 700; color: var(--fg); text-decoration: none; }
  nav { display: flex; flex-wrap: wrap; gap: 16px; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a[aria-current="page"], nav a:hover { color: var(--fg); }
  main.wrap { padding-top: 32px; padding-bottom: 48px; }
  main.wrap.wide { max-width: 1200px; }
  footer.wrap { border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; padding-top: 16px; padding-bottom: 32px; }
  a { color: var(--accent); }
  h1 { font-size: 2rem; line-height: 1.2; margin: 0 0 8px; }
  h2 { font-size: 1.25rem; margin: 32px 0 8px; }
  .lede { color: var(--muted); margin: 0 0 24px; }
  .muted { color: var(--muted); }
  .list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 16px; }
  .card h3 { margin: 0 0 4px; font-size: 1.05rem; }
  .card p { margin: 0; }
  .meta { font-size: 14px; color: var(--muted); }
  code, pre { font: 13px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
  pre { background: var(--code); border-radius: 8px; padding: 10px 12px; overflow-x: auto; margin: 8px 0 0; }
  :not(pre) > code { background: var(--code); padding: 1px 5px; border-radius: 4px; }
  .tag { display: inline-block; font-size: 12px; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 0 8px; margin-right: 4px; }
  .prose img { max-width: 100%; }
  .prose table { display: block; overflow-x: auto; border-collapse: collapse; margin: 12px 0; font-size: 14px; }
  .prose th, .prose td { border: 1px solid var(--line); padding: 4px 8px; text-align: left; vertical-align: top; }
  .prose th { background: var(--code); }
  .prose blockquote { margin: 12px 0; padding: 0 12px; border-left: 3px solid var(--line); color: var(--muted); }
</style>
