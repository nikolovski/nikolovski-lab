{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "site/dist",
  "functions": {
    "api/mcp.mjs": {
      "includeFiles": "{skills,lessons}/**",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/mcp/", "destination": "/api/mcp" }
  ]
}
